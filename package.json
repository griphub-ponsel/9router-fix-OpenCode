{
  "name": "9router-app",
  "version": "0.5.35",
  "description": "9Router web dashboard",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-vite.mjs",
    "dev:live": "node scripts/dev-vite.mjs",
    "dev:webpack": "node scripts/dev-vite.mjs",
    "dev:preview": "vite --host 127.0.0.1 --port 20127",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist-server/index.js",
    "dev:bun": "bun scripts/dev-vite.mjs",
    "build:bun": "npm run build",
    "start:bun": "bun dist-server/index.js",
    "cli:pack": "npm --prefix cli run pack:cli",
    "cli:publish": "npm --prefix cli run publish:cli",
    "build:server": "node scripts/build-server.mjs",
    "test:server": "node --experimental-default-type=module --test server/*.test.js",
    "start:server": "node dist-server/index.js",
    "build:client": "vite build",
    "test:vite-routes": "node --test src/vite/route-utils.test.mjs && node --import tsx --test src/vite/navigation.test.jsx"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@xenova/transformers": "^2.17.2",
    "@xyflow/react": "^12.10.1",
    "bcryptjs": "^3.0.3",
    "cloakbrowser": "^0.4.3",
    "confbox": "^0.2.4",
    "express": "^5.2.1",
    "fs": "^0.0.1-security",
    "http-proxy-middleware": "^3.0.5",
    "jose": "^6.1.3",
    "marked": "^18.0.1",
    "material-symbols": "^0.44.6",
    "monaco-editor": "^0.55.1",
    "node-forge": "^1.3.3",
    "node-machine-id": "^1.1.12",
    "open": "^11.0.0",
    "ora": "^9.1.0",
    "prop-types": "^15.8.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-is": "^16.13.1",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.7.0",
    "selfsigned": "^5.5.0",
    "socks-proxy-agent": "^8.0.5",
    "sql.js": "^1.14.1",
    "sqlite3": "^6.0.1",
    "undici": "^7.19.2",
    "uuid": "^13.0.0",
    "vite": "^8.1.5",
    "zustand": "^5.0.10"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.6.2"
  },
  "comment_better_sqlite3": "kept in optionalDependencies so npm install doesn't fail on systems without build tools — sql.js is used as fallback at runtime",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.1.18",
    "esbuild": "^0.27.3",
    "eslint": "^9",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3"
  }
}
